# Contexto de build de la imagen del backend (app).
# Control de versiones y editor
.git
.gitignore
.gitattributes
.editorconfig

# Secretos: NUNCA entran a la imagen
.env
.env.*

# Dependencias y artefactos (se regeneran dentro del build)
vendor
node_modules
public/build
public/hot

# Frontend de plantilla de Laravel: esto es una API, no se usa
package.json
vite.config.js

# Pruebas y documentación
tests
phpunit.xml
.phpunit.cache
README.md

# Archivos de Docker que no deben copiarse dentro de la imagen
Dockerfile
Dockerfile.dockerignore
.dockerignore
nginx

# Estado de ejecución local
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
