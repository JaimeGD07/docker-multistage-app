# =============================================================================
# Variables de entorno del ecosistema (copiar a .env: cp .env.example .env)
# docker compose lee este archivo automáticamente.
# NUNCA subas el .env real al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos MySQL
# -----------------------------------------------------------------------------
# Contraseña del usuario root de MySQL (solo administración).
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
# Base de datos que se crea automáticamente en el primer arranque.
MYSQL_DATABASE=ecommerce_api
# Usuario de aplicación (la API Laravel se conecta con este usuario).
MYSQL_USER=laravel
MYSQL_PASSWORD=cambia_esta_clave_app

# -----------------------------------------------------------------------------
# Backend Laravel
# -----------------------------------------------------------------------------
APP_NAME="E-commerce API"
# URL pública de la API tal como la ve el navegador / el host
APP_URL=http://localhost:8030
# Puerto del host donde se publica la API (Nginx)
API_PORT=8030

# Clave de cifrado de Laravel. Genera una con:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# Secreto para firmar los JWT. Genera uno con:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
# Clave SECRETA de Stripe en modo test (sk_test_...)
STRIPE_SECRET=

# true = ejecuta `php artisan migrate --force` al arrancar el contenedor
RUN_MIGRATIONS=true
# Nivel de logs (los logs salen por stderr: docker compose logs app)
LOG_LEVEL=warning
