# =============================================================================
# Variables de entorno del ecosistema (copiar a .env: cp .env.example .env)
# docker compose lee este archivo automáticamente.
# NUNCA subas el .env real al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos MySQL
# -----------------------------------------------------------------------------
# Contraseña del usuario root de MySQL (solo administración).
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
# Base de datos que se crea automáticamente en el primer arranque.
MYSQL_DATABASE=ecommerce_api
# Usuario de aplicación (la API Laravel se conecta con este usuario).
MYSQL_USER=laravel
MYSQL_PASSWORD=cambia_esta_clave_app
